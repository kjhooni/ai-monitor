prometheus_url: "http://prometheus:9090"
poll_interval_seconds: 60
callback_base_url: "http://YOUR_PUBLIC_IP_OR_DOMAIN:8080"  # 담당자가 Teams 버튼을 누를 때 접근할 자동조치 서버 주소.
                                                            # 비워두면 승인 절차 없이 Claude 판단만으로 자동조치가 즉시 실행됨.

thresholds:
  cpu_percent: 85
  memory_percent: 90
  disk_percent: 90
  swap_percent: 90

nodes:
  kimjh-test01:
    ip: "YOUR_NODE_IP"
    owner: "담당자명"
    teams_mention_id: ""  # Teams 멘션용 AAD Object ID (선택, Azure AD에서 확인)
    teams_webhook: ""     # Teams 채널 Incoming Webhook URL 입력
    ssh_user: "root"
    ssh_password: "YOUR_SSH_PASSWORD"

  kimjh-test02:
    ip: "YOUR_NODE_IP"
    owner: "담당자명"
    teams_mention_id: ""  # Teams 멘션용 AAD Object ID (선택, Azure AD에서 확인)
    teams_webhook: "YOUR_TEAMS_WEBHOOK_URL"
    ssh_user: "root"
    ssh_password: "YOUR_SSH_PASSWORD"
